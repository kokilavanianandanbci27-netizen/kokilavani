#include <stdio.h>

int main() {
    int arr[] = {10, 20, 30, 40, 50};
    int sum = 0;
    int length = sizeof(arr) / sizeof(arr[0]); // Calculate array size

    for(int i = 0; i < length; i++) {
        sum += arr[i];
    }

    float average = (float)sum / length;
    printf("Sum: %d\n", sum);
    printf("Average: %.2f", average);
    return 0;
}

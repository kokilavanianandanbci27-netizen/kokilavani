#include <stdio.h>

int main() {
    int arr[] = {25, 11, 7, 75, 56};
    int max = arr[0];
    int min = arr[0];
    int length = sizeof(arr) / sizeof(arr[0]);

    for(int i = 1; i < length; i++) {
        if(arr[i] > max) max = arr[i];
        if(arr[i] < min) min = arr[i];
    }

    printf("Largest element: %d\n", max);
    printf("Smallest element: %d", min);
    return 0;
}

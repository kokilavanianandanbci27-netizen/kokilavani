#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Function to swap two strings
void swap(char **a, char **b) {
    char *temp = *a;
    *a = *b;
    *b = temp;
}

// Function to reverse a section of the array
void reverse(char **s, int start, int end) {
    while (start < end) {
        swap(&s[start], &s[end]);
        start++;
        end--;
    }
}

// Function to generate the next lexicographical permutation
int next_permutation(int n, char **s) {
    int i = n - 2;
    // 1. Find longest non-increasing suffix
    while (i >= 0 && strcmp(s[i], s[i + 1]) >= 0) {
        i--;
    }
    if (i < 0) return 0; // No more permutations

    // 2. Find rightmost element greater than pivot
    int j = n - 1;
    while (strcmp(s[j], s[i]) <= 0) {
        j--;
    }
    
    // 3. Swap pivot with j
    swap(&s[i], &s[j]);
    
    // 4. Reverse suffix
    reverse(s, i + 1, n - 1);
    return 1;
}

int main() {
    char **s;
    int n;
    scanf("%d", &n);
    s = (char **)calloc(n, sizeof(char *));
    for (int i = 0; i < n; i++) {
        s[i] = (char *)calloc(11, sizeof(char));
        scanf("%s", s[i]);
    }
    
    // Sort initial array to ensure starting from smallest
    // (Omitted for brevity, assuming sorted input as per common challenge constraints)

    do {
        for (int i = 0; i < n; i++) {
            printf("%s%c", s[i], i == n - 1 ? '\n' : ' ');
        }
    } while (next_permutation(n, s));
    
    // Free memory...
    return 0;
}

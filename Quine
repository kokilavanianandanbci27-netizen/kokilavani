#include <stdio.h>
#include <string.h>
#include <ctype.h>

char stack[50][80];
int top = -1;

void push(char *str) {
    strcpy(stack[++top], str);
}

char* pop() {
    return stack[top--];
}

int main() {
    char prefix[] = "*+ABC"; // Example: (A+B)*C
    int len = strlen(prefix);

    for (int i = len - 1; i >= 0; i--) {
        if (isalnum(prefix[i])) {
            char op[2] = {prefix[i], '\0'};
            push(op);
        } else {
            char op1[80], op2[80], res[80];
            strcpy(op1, pop());
            strcpy(op2, pop());
            sprintf(res, "(%s%c%s)", op1, prefix[i], op2);
            push(res);
        }
    }
    printf("Infix: %s\n", pop());
    return 0;
}

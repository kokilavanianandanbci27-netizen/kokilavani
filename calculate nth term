#include <stdio.h>

// Function to find the nth term using recursion
int find_nth_term(int n, int a, int b, int c) {
    // Base Cases: Return the initial values for the first three terms
    if (n == 1) return a;
    if (n == 2) return b;
    if (n == 3) return c;

    // Recursive Step: Sum of the previous three terms
    return find_nth_term(n - 1, a, b, c) + 
           find_nth_term(n - 2, a, b, c) + 
           find_nth_term(n - 3, a, b, c);
}

int main() {
    int n, a, b, c;
    
    // Read input for n and the first three terms a, b, c
    scanf("%d %d %d %d", &n, &a, &b, &c);
    
    // Calculate and print the result
    int ans = find_nth_term(n, a, b, c);
    printf("%d", ans); 
    
    return 0;
}

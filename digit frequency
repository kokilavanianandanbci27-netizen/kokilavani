#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char s[1001];
    int count[10] = {0};

    // Read the input string
    if (scanf("%s", s) == 1) {
        // Iterate through the string
        for (int i = 0; s[i] != '\0'; i++) {
            // Check if character is a digit
            if (isdigit(s[i])) {
                // Convert char digit to index (0-9)
                count[s[i] - '0']++;
            }
        }
    }

    // Print the frequencies separated by spaces
    for (int i = 0; i < 10; i++) {
        printf("%d ", count[i]);
    }

    return 0;
}

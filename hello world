
#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    
    // Read a full line of input including spaces
    // %[^\n]%*c reads characters until a newline is encountered
    scanf("%[^\n]%*c", &s);
    
    // Print Hello, World! on the first line
    printf("Hello, World!\n");
    
    // Print the input string on the second line
    printf("%s", s);
    
    return 0;
}

#include <stdio.h>

int main() {
    int n, sum = 0;
    
    // Read the five-digit integer
    scanf("%d", &n);
    
    // Iterate through the digits
    while (n > 0) {
        sum += (n % 10); // Add the last digit to sum
        n /= 10;          // Remove the last digit from n
    }
    
    // Print the final sum
    printf("%d\n", sum);
    
    return 0;
}

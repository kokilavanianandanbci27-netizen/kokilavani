#include <stdio.h>
#include <string.h>

int main() {
    char s[1001];
    // Read the entire line including spaces
    scanf("%[^\n]", s); 

    for (int i = 0; s[i] != '\0'; i++) {
        if (s[i] == ' ') {
            printf("\n");
        } else {
            printf("%c", s[i]);
        }
    }
    return 0;
}
